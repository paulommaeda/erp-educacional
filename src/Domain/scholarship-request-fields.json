        "label": "Renda Individual Mãe",
        "type": "text",
        "required": true
      },
      {
        "key": "profissao_pai",
        "label": "Profissão Pai",
        "type": "text",
        "required": true
      },
      {
        "key": "renda_pai",
        "label": "Renda Individual Pai",
        "type": "text",
        "required": true
      }
    ]
  },
